<idea-plugin>
    <id>com.github.ideanovel.reader</id>
    <name>摸鱼小说阅读器</name>
    <version>1.0.10</version>
    <vendor email="ideanovel@example.com" url="https://github.com/ideanovel">ideanovel</vendor>

    <description><![CDATA[
    <p>在 IntelliJ IDEA 里光明正大地看小说。侧边栏嵌入阅读窗口，支持本地 txt 与网络小说，自带章节目录、阅读进度记忆和一键隐身。</p>
    <ul>
        <li>侧边工具窗阅读，正文渲染支持字号/行距/配色调整</li>
        <li>本地 txt 自动识别编码（UTF-8 / GBK / UTF-16），按章节切分</li>
        <li>网络小说目录解析 + 章节懒加载</li>
        <li>章节目录树，支持搜索快速跳转</li>
        <li>阅读进度自动保存，下次打开回到上次位置</li>
        <li>老板键一键伪装：切换成构建日志 / 代码 / 终端界面</li>
        <li>代码提示框阅读：光标旁浮出悬停提示样式的小窗，一次读一小段，不开侧边栏也能看</li>
        <li>自动滚动翻页，解放双手</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <ul>
        <li>1.0.10 「代码弹出框」改版为「代码提示框」：从带行号的源码大窗换成贴在光标旁的悬停提示样式小浮窗——一次显示一小截正文和 (n/N) 段进度，正文按句末标点切成 60 字以内的小段，几乎不挡代码。滚轮/方向键翻段，翻到章尾自动进下一章、章首往前自动回上一章末尾，Esc 就散</li>
        <li>1.0.9 新增「代码弹出框阅读」：按 Ctrl+Alt+Shift+C 在光标附近弹出一个像 IDE 快速文档的浮窗，正文同样是渲染成 Java 文件的 Javadoc 注释块，带行号。不用开侧边栏，Esc 就散；Ctrl+↑↓ 或 Ctrl+PgUp/PgDn 翻章，Ctrl+滚轮 调字号，方向键/PgUp/PgDn 滚动。再按一次快捷键即关闭，且尺寸位置会被记住</li>
        <li>1.0.8 修复：目录里同一章出现两遍。部分 txt 会把标题行连写两遍，缩进用的是全角空格，本地清洗时被换成了普通空格，于是缩进的那一行也被识别成章节标题，同一章被切成「只有标题的空章节 + 真正带正文的章节」两份。现在连着出现、中间没有正文的标题会合并成一章，多余的那一行既不会单独成章，也不会留在上一章末尾</li>
        <li>1.0.7 书架改版：每条记录可单独删除（悬停出现删除按钮，点两次确认），底部支持一键清空；行内显示书名、类型、读到第几章和「多久以前」；工具栏导航按钮统一为「图标 + 文字」的扁平样式</li>
        <li>1.0.6 修复：长篇小说目录只显示到第 787 章（原先硬截断前 800 条，导致末尾章节永远点不到）；搜索时状态栏显示「匹配 x / y 章」</li>
        <li>1.0.5 新增伪装模式「源码（正文作注释）」：小说正文渲染成 Java 文件的 Javadoc 注释块，配色字体取自 IDE 编辑器，伪装时仍可继续阅读</li>
        <li>1.0.4 「自动滚动」图标改为向下箭头，不再和「下一章」的 ▶ 混淆；滚动中图标切换为暂停，状态一眼可见</li>
        <li>1.0.3 修复：鼠标滚轮滚动正文失效（给正文注册滚轮监听会截断事件向上传播，已补回滚动）</li>
        <li>1.0.2 修复：滚轮无法滚动正文、切换章节不回到开头</li>
        <li>1.0.1 侧边栏变窄时工具栏自动折行，不再裁掉右侧按钮；新增工具栏右键菜单和图标按钮模式</li>
        <li>1.0.0 首个版本：本地/网络小说阅读、章节目录、进度记忆、老板键伪装、自动滚动</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <!--
        声明兼容区间。不写 since-build 的话 IDEA 会把插件当成「适用所有版本」，
        在旧版 IDE 上也会允许安装，然后因为 API 不兼容直接抛异常。
        242 = 2024.2，until-build 留空表示向上兼容。
    -->
    <idea-version since-build="242"/>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="摸鱼小说"
                    secondary="true"
                    anchor="right"
                    icon="/icons/novel.svg"
                    factoryClass="com.github.ideanovel.ui.NovelReaderToolWindowFactory"/>

        <applicationService serviceImplementation="com.github.ideanovel.service.NovelReaderService"/>
        <applicationService serviceImplementation="com.github.ideanovel.settings.NovelSettingsState"/>

        <applicationConfigurable parentId="tools"
                                 instance="com.github.ideanovel.settings.NovelSettingsConfigurable"
                                 id="com.github.ideanovel.settings"
                                 displayName="摸鱼小说"/>

        <notificationGroup id="Idea Novel Reader"
                          displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="IdeaNovel.OpenLocal"
                class="com.github.ideanovel.action.OpenLocalNovelAction"
                text="打开本地小说..."
                description="选择一个本地 txt 小说文件并开始阅读">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="IdeaNovel.OpenRemote"
                class="com.github.ideanovel.action.OpenRemoteNovelAction"
                text="打开网络小说..."
                description="输入小说目录页地址，解析章节后阅读">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="IdeaNovel.BossKey"
                class="com.github.ideanovel.action.BossKeyAction"
                text="老板键：隐身/还原"
                description="一键把阅读面板伪装成构建日志、代码或终端界面">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift X"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="IdeaNovel.CodePopup"
                class="com.github.ideanovel.action.CodePopupAction"
                text="代码提示框阅读"
                description="在光标旁浮出一小块悬停提示样式的小窗读小说，滚轮或方向键翻段，按 Esc 关闭">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="IdeaNovel.NextChapter"
                class="com.github.ideanovel.action.NextChapterAction"
                text="下一章"
                description="跳到下一章">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt RIGHT"/>
        </action>

        <action id="IdeaNovel.PrevChapter"
                class="com.github.ideanovel.action.PrevChapterAction"
                text="上一章"
                description="跳到上一章">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt LEFT"/>
        </action>

        <action id="IdeaNovel.IncreaseFontSize"
                class="com.github.ideanovel.action.IncreaseFontSizeAction"
                text="放大阅读字号"
                description="放大小说正文的字号（也可在正文区用 Ctrl+滚轮 缩放）">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift EQUALS"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift ADD"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="IdeaNovel.DecreaseFontSize"
                class="com.github.ideanovel.action.DecreaseFontSizeAction"
                text="缩小阅读字号"
                description="缩小说正文的字号（也可在正文区用 Ctrl+滚轮 缩放）">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift MINUS"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift SUBTRACT"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
